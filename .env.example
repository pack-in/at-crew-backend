# 로컬 환경 변수 양식. 실제 값은 .env에 넣는다(.env는 gitignore 대상).
# orca 워크트리에는 .env가 복사되지 않으므로 원본 레포의 .env를 심볼릭 링크로 연결한다.
#   ln -s /Users/danhan/Development/at-crew-backend/.env .env
# 값을 비워 두면 application.yml의 기본값이 쓰인다.
#
# 주의: 이 파일은 실행 환경(IntelliJ 실행 구성·셸)이 환경변수로 주입하는 용도다.
# application.yml에 spring.config.import로 .env를 직접 읽게 하면 테스트 컨텍스트에서
# Testcontainer 접속 정보가 어긋나 검색·이벤트 레지스트리 테스트가 깨진다(확인 완료).

SPRING_PROFILES_ACTIVE=local

JWT_SECRET=
FIREBASE_CREDENTIALS_PATH=

MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=
MARIADB_USERNAME=
MARIADB_PASSWORD=

ELASTICSEARCH_URIS=

WORKER_TRIGGER_URL=
WORKER_CALLBACK_SECRET=
ARTWORK_INTERNAL_SECRET=
SEARCH_INTERNAL_SECRET=

CORS_ALLOWED_ORIGINS=

# --- Stripe (test mode 전용, 라이브 키를 넣지 않는다) ---
# Dashboard > Developers > API keys 에서 복사
STRIPE_SECRET_KEY=sk_test_
STRIPE_PUBLISHABLE_KEY=pk_test_
# `stripe listen --forward-to localhost:8080/internal/billing/stripe/webhook` 실행 시 출력되는 값
STRIPE_WEBHOOK_SECRET=whsec_

# Dashboard에서 USD로 생성한 Price ID (가격표는 plans/260813-stripe-billing/PLAN-HUMAN.md PH-02 참고)
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_PRO_YEARLY=price_
STRIPE_PRICE_TEAM_POSTING=price_
STRIPE_PRICE_BOOST=price_
STRIPE_PRICE_JOB_POSTING=price_

# Checkout 복귀 URL 기준. 로컬 http://localhost:3000, prod https://at-crew.com
FRONTEND_BASE_URL=http://localhost:3000
