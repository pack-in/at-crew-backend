{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "프로덕션 배포 파이프라인",
    "quality_profile": "showcase",
    "legend": {
      "entries": {
        "external": {
          "label": "트리거·통지"
        },
        "backend": {
          "label": "실행 단계"
        },
        "cloud": {
          "label": "이미지 저장소"
        },
        "security": {
          "label": "검증·게이트"
        },
        "messagebus": {
          "label": "복구 조치"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "actions",
      "label": "GitHub Actions (main push)"
    },
    {
      "id": "server",
      "label": "EC2 (SSM으로 원격 실행)"
    },
    {
      "id": "failure",
      "label": "헬스체크 실패 처리",
      "variant": "exception"
    },
    {
      "id": "notify",
      "label": "Discord 통지"
    }
  ],
  "phases": [
    {
      "id": "build",
      "label": "빌드와 이미지",
      "fromCol": 0,
      "toCol": 2
    },
    {
      "id": "release",
      "label": "서버 반영",
      "fromCol": 3,
      "toCol": 4,
      "variant": "emphasis"
    },
    {
      "id": "verify",
      "label": "검증",
      "fromCol": 5,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "push",
    "build",
    "image",
    "sync",
    "up",
    "health",
    "ok"
  ],
  "nodes": [
    {
      "id": "push",
      "lane": "actions",
