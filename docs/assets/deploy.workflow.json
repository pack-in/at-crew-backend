      "width": 132
    },
    {
      "id": "fail",
      "lane": "notify",
      "col": 2,
      "type": "external",
      "label": "P1 배포 실패",
      "sublabel": "롤백 결과 · 수동 대응",
      "width": 132
    },
    {
      "id": "ok",
      "lane": "notify",
      "col": 5,
      "type": "external",
      "label": "P2 배포 성공"
    }
  ],
  "edges": [
    {
      "from": "push",
      "to": "build",
      "role": "main"
    },
    {
      "from": "build",
      "to": "image",
      "role": "main"
    },
    {
      "from": "image",
      "to": "sync",
      "role": "main",
      "label": "SSM"
    },
    {
      "from": "sync",
      "to": "up",
      "role": "main"
    },
    {
      "from": "up",
      "to": "health",
      "role": "main"
    },
    {
      "from": "health",
      "to": "ok",
      "role": "main",
      "label": "UP"
    },
    {
      "from": "health",
      "to": "mig",
      "role": "error",
      "variant": "security",
      "label": "3분 초과"
    },
    {
      "from": "mig",
      "to": "rollback",
      "role": "error",
      "label": "없음"
    },
    {
      "from": "mig",
      "to": "fail",
      "role": "error",
      "variant": "security",
      "label": "있음: 롤백 안 함"
    },
    {
      "from": "rollback",
      "to": "fail",
      "role": "return",
      "variant": "dashed",
      "label": "결과 통지"
    }
  ]
}
