    },
    {
      "id": "image",
      "lane": "actions",
      "col": 2,
      "type": "cloud",
      "label": "이미지 푸시",
      "sublabel": "SHA + latest"
    },
    {
      "id": "sync",
      "lane": "server",
      "col": 3,
      "type": "security",
      "label": "deploy/ 동기화",
      "sublabel": "nginx -t 후 reload",
      "width": 132
    },
    {
      "id": "up",
      "lane": "server",
      "col": 4,
      "type": "backend",
      "label": "컨테이너 교체",
      "sublabel": "up -d, 기동 시 Flyway",
      "width": 132
    },
    {
      "id": "health",
      "lane": "server",
      "col": 5,
      "type": "security",
      "label": "헬스체크",
      "sublabel": "liveness 36회 × 5초",
      "width": 132
    },
    {
      "id": "mig",
      "lane": "failure",
      "col": 4,
      "type": "security",
      "label": "마이그레이션 판정",
