{
  "uid": "atcrew-infra",
  "title": "at-crew 인프라",
  "description": "EC2 #1 자원과 백엔드 의존성 상태.",
  "tags": [
    "at-crew"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "CPU 사용률",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
          "legendFormat": "cpu",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "메모리 사용률",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "memory",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "루트 디스크 사용률",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 - (node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"} * 100)",
          "legendFormat": "disk",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 70
              },
              {
                "color": "red",
                "value": 85
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "85% 초과 시 P1. 대부분 원인은 쌓인 도커 이미지다."
    },
    {
      "id": 10,
      "title": "JVM 힙 사용",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{job=\"at-crew-backend\",area=\"heap\"})",
          "legendFormat": "used",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{job=\"at-crew-backend\",area=\"heap\"})",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 11,
      "title": "DB 커넥션 풀",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(hikaricp_connections_active{job=\"at-crew-backend\"})",
          "legendFormat": "active",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "expr": "max(hikaricp_connections_pending{job=\"at-crew-backend\"})",
          "legendFormat": "pending",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "expr": "max(hikaricp_connections_max{job=\"at-crew-backend\"})",
          "legendFormat": "max",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {},
      "description": "pending이 0보다 크게 유지되면 풀이 부족하거나 쿼리가 느린 것이다."
    },
    {
      "id": 12,
      "title": "컨테이너 메모리",
      "type": "timeseries",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (container_memory_working_set_bytes{name=~\".+\"})",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 20,
      "title": "마지막 백업 이후 경과",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(atcrew_backup_last_success_timestamp)",
          "legendFormat": "경과",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "26시간(93600초)을 넘으면 P1. 데이터 없음은 백업이 아직 구축되지 않았다는 뜻."
    },
    {
      "id": 21,
      "title": "백업 파일 크기",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(atcrew_backup_size_bytes)",
          "legendFormat": "size",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {},
      "description": "갑자기 작아지면 덤프가 깨졌을 수 있다."
    },
    {
      "id": 22,
      "title": "미완료 이벤트",
      "type": "timeseries",
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(atcrew_modulith_incomplete_events)",
          "legendFormat": "events",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      },
      "options": {}
    }
  ]
}
