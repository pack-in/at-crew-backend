{
  "uid": "atcrew-overview",
  "title": "at-crew 서비스 개요",
  "description": "장애 판단용 단일 화면. 위쪽은 살아 있는지, 가운데는 얼마나 아픈지, 아래는 비즈니스가 돌고 있는지.",
  "tags": [
    "at-crew"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "title": "앱 생존 (up)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "__PROM_UID__"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(up{job=\"at-crew-backend\"})",
          "legendFormat": "up",
          "datasource": {
            "type": "prometheus",
            "uid": "__PROM_UID__"
          },
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "Alloy가 관리 포트를 스크레이프할 수 있는지. 0이면 P1."
    },
