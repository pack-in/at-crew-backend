# MariaDB Replica 복제 지연 체크(docs/design/infra-security-hardening-design.md D6).
[Unit]
Description=AT-CREW Replica 복제 지연 체크
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/at-crew-backend/deploy
ExecStart=/home/ec2-user/at-crew-backend/deploy/replica-lag-check.sh
