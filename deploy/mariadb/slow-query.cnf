# 슬로우 쿼리 로그 (이슈 #118)
#
# MariaDB는 /etc/mysql/conf.d/*.cnf 를 자동으로 읽는다. compose의 command 인자에 붙이지 않고
# 파일로 분리한 이유는 두 가지다.
#   1. command 인자에는 문자셋·복제 설정이 이미 여러 개 들어 있어 튜닝 값까지 섞으면 읽기 어렵다
#   2. 설정마다 이유를 주석으로 남길 수 있다 — command 한 줄에는 못 적는다
#
# 켜는 것 자체가 부하다. 임계를 너무 낮게 잡으면 정상 쿼리까지 기록되어 디스크 IO가 늘고,
# 그게 다시 응답시간을 늘린다. 아래 값에서 시작해 실제로 잡히는 양을 보고 조정한다.

[mariadbd]
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow-query.log

# 기본값 10초는 사실상 아무것도 안 잡는다 — 2026-09-02 부하 측정에서 포화 시 p99가 4초대였다.
# 1초면 정상 구간(p50 약 50ms)은 그냥 지나가고 문제 있는 쿼리만 걸린다.
long_query_time = 1

# 인덱스를 안 타는 쿼리까지 잡는 옵션(log_queries_not_using_indexes)은 켜지 않는다.
# 소규모 테이블 풀스캔이 전부 기록되어 로그가 폭증한다. 필요해지면 그때 한시적으로 켠다.
