# EC2 #1(앱 서버)의 deploy/ 디렉토리에 이 파일을 .env로 복사해서 실제 값을 채운다.
# scp로만 옮기고 git에는 절대 커밋하지 않는다. MARIADB_HOST/MARIADB_PORT는 docker-compose.app.yml이
# 컨테이너 네트워크 기준으로 덮어쓰므로 여기 넣지 않는다.

SPRING_PROFILES_ACTIVE=prod

# === MariaDB (docker-compose.app.yml의 mariadb 컨테이너) ===
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=atcrew
MARIADB_USERNAME=root
# 위 두 값이 일치해야 함(root로 접속하는 경우). 별도 앱 전용 계정을 만들 거면 두 값을 분리하고
# MariaDB 컨테이너 최초 기동 시 GRANT까지 직접 실행할 것.
MARIADB_PASSWORD=

# === Elasticsearch (이슈 #76 — EC2 #1로 통합, docker-compose.app.yml) ===
# 같은 compose 네트워크 안의 서비스명으로 접근 — 포트를 호스트에 노출하지 않는다.
# Elasticsearch는 xpack.security를 끈 채로 뜬다 — 네트워크 격리(포트 미노출)가 유일한 방어선이다.
ELASTICSEARCH_URIS=http://elasticsearch:9200

# === Cloudflare R2 (media 모듈) ===
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=at-crew-storage

# === Cloudflare Worker (media 모듈 트리거/콜백) ===
# WORKER_TRIGGER_URL은 이미 배포된 워커 고정 URL(https://<워커이름>.<계정서브도메인>.workers.dev).
# workers.dev URL은 인터넷에 열려 있고 X-Callback-Secret 헤더만이 방어선이므로 여기 적지 않는다.
# WORKER_CALLBACK_SECRET은 Worker의 wrangler secret CALLBACK_SECRET과 동일해야 함.
WORKER_TRIGGER_URL=
WORKER_CALLBACK_SECRET=
# Worker의 wrangler secret SERVER_CALLBACK_URL도 이 서버가 뜬 뒤 실제 도메인으로 재등록해야 한다:
#   https://api.at-crew.com/internal/media/images/processed
ARTWORK_INTERNAL_SECRET=

# === search 모듈 내부 시크릿 ===
SEARCH_INTERNAL_SECRET=

# === Firebase ===
# 서비스 계정 JSON 파일을 이 deploy/ 디렉토리에 정확히 "firebase-credentials.json"이라는 이름으로
# 올려둘 것(git에 없음). docker-compose.app.yml이 그 파일을 컨테이너 안 /app/firebase-credentials.json
# 으로 마운트하고 FIREBASE_CREDENTIALS_PATH도 그 경로로 강제 덮어쓰므로, 아래 값은 실제로는 안 쓰인다
# (컨테이너 밖에서 값을 참고할 일이 있을까 봐 형식만 유지).
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# === 이메일 발송 (Resend) — 비밀번호 재설정 메일(docs/design/auth-email-custom-redesign.md §7) ===
RESEND_API_KEY=
# Resend에서 도메인 인증 전이면 onboarding@resend.dev로 임시 발송 가능(발신자 제한 있음).
# 커스텀 도메인 발신은 Cloudflare DNS에 SPF/DKIM 레코드 등록이 필요(root DNS 편집 권한 요청과 동일 건).
MAIL_FROM_ADDRESS=AT-CREW <onboarding@resend.dev>

# === 비밀번호 재설정 코드 HMAC pepper (이슈 #151) ===
# 6자리 코드(32^6 조합)는 평문 SHA-256만으로는 DB 유출 시 사전계산 테이블로 역산 가능해 서버 시크릿을
# 더한다. 외부 서비스 발급이 아니라 이 서버만 아는 난수 문자열이면 된다 — 로컬에서 생성해 채워 넣는다:
#   openssl rand -base64 32
# 로테이션하면 이미 발급된 코드가 전부 무효화된다(재요청하면 되므로 치명적이지 않음).
PASSWORD_RESET_CODE_PEPPER=

# === 프론트엔드 ===
# 비밀번호 재설정 메일의 링크(`{FRONTEND_BASE_URL}/reset-password?token=...`)와 Stripe Checkout
# 성공·취소 후 돌아갈 주소 양쪽에 쓰인다.
FRONTEND_BASE_URL=https://at-crew.com

# === CORS / JWT ===
CORS_ALLOWED_ORIGINS=https://at-crew.com
JWT_SECRET=

# === Stripe 결제/구독 (docs/design/billing-module-design.md) ===
# 값이 비어 있어도 앱은 기동되고 결제 API만 실패한다. 지금은 sandbox(test mode) 키를 쓴다.
# 주의: properties 형식이라 값 뒤에 같은 줄로 # 주석을 달면 주석까지 값에 섞인다.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# 대시보드 Webhooks에 등록한 destination의 Signing secret
# (엔드포인트: https://api.at-crew.com/internal/billing/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# Product이 아니라 Price의 ID를 넣는다. Checkout에 넘기는 값은 Price이고, 하나의 Product 아래
# 청구 주기마다 Price가 따로 있다 — Creator Pro도 월간·연간이 서로 다른 Price ID다.
#
# 찾는 법: 대시보드 > Product catalog > 해당 상품 > Pricing 표의 행 오른쪽 (···) > "Copy price ID".
# 상품 상세 우측 Details에 크게 보이는 "Product ID"는 여기 넣는 값이 아니다.
#
# 넣기 전에 값을 검증한다(빈 값·오타를 넣으면 앱은 그대로 뜨고 결제만 500 STRIPE_REQUEST_FAILED로 죽는다.
# 2026-09-09에 실제로 Product ID 계열 값이 들어가 월간·연간 결제가 함께 멈췄다):
#   curl -s -H "Authorization: Bearer $STRIPE_SECRET_KEY" https://api.stripe.com/v1/prices/<price_id>
# 200에 unit_amount·recurring.interval이 application.yml의 amount와 맞는지 확인한다. 계정이 다르면
# "No such price"가 나오므로 키와 Price가 같은 계정·모드인지도 이걸로 함께 확인된다.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# 아래 단건 3종은 application.yml에서 enabled: false라 카탈로그·Checkout 양쪽에서 막혀 있다.
# 판매를 재개하기 전까지는 비워 둬도 된다(빈 값이어도 기동에 영향이 없다).
STRIPE_PRICE_TEAM_POSTING=
STRIPE_PRICE_BOOST=
STRIPE_PRICE_JOB_POSTING=

# === 에러 추적 (Sentry, docs/design/observability-design.md §5) ===
# prod에서는 값이 없으면 기동이 실패한다(application-prod.yml의 fail-fast).
SENTRY_DSN=
# 비워 두면 local. prod 프로파일은 application-prod.yml이 prod로 고정한다.
SENTRY_ENVIRONMENT=

# === 관측 수집 (Grafana Cloud, docker-compose.observability.yml의 Alloy가 읽는다) ===
# Grafana Cloud > 좌측 하단 계정 > "Details" 또는 각 데이터소스 설정 화면에서 확인한다.
# URL·USER는 스택마다 다르고, TOKEN 하나를 Prometheus·Loki 양쪽 basic_auth 비밀번호로 공유한다.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_TOKEN=

# DB 지표 수집용 DSN(Alloy의 prometheus.exporter.mysql). root를 쓰지 않고 최소 권한 계정을 만든다.
#   CREATE USER 'exporter'@'%' IDENTIFIED BY '<강한-비밀번호>';
#   GRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'%';
#   GRANT SLAVE MONITOR ON *.* TO 'exporter'@'%';   -- MariaDB 11.4는 REPLICATION CLIENT로
#                                                   -- slave_status를 못 읽는다(실측, 2026-09-03)
#   FLUSH PRIVILEGES;
# 이 값이 없으면 Alloy가 기동에 실패한다 — 새 호스트에서는 bootstrap.sh가 먼저 걸러낸다.
MYSQL_EXPORTER_DSN=exporter:<비밀번호>@(127.0.0.1:3306)/

# === DB 백업 (deploy/backup.sh, 일 1회 dump -> R2) ===
# 반드시 실제 버킷 이름을 채운다. 비워 두면 스크립트가 at-crew-backups로 폴백하는데
# 운영 버킷 이름은 그것과 달라서, 없는 버킷에 업로드하려다 백업이 실패한다.
R2_BACKUP_BUCKET=
# 백업 버킷에만 권한이 있는 전용 키. 비워 두면 위의 이미지용 R2_ACCESS_KEY/R2_SECRET_KEY로 폴백하는데,
# 그 키에는 백업 버킷 권한이 없으므로 전용 키를 발급해 채우는 것이 정상 구성이다.
R2_BACKUP_ACCESS_KEY=
R2_BACKUP_SECRET_KEY=
