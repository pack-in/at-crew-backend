# EC2 #1(앱 서버)의 deploy/ 디렉토리에 이 파일을 .env로 복사해서 실제 값을 채운다.
# scp로만 옮기고 git에는 절대 커밋하지 않는다. MARIADB_HOST/MARIADB_PORT는 docker-compose.app.yml이
# 컨테이너 네트워크 기준으로 덮어쓰므로 여기 넣지 않는다.

SPRING_PROFILES_ACTIVE=prod

# === MariaDB (docker-compose.app.yml의 mariadb 컨테이너) ===
MARIADB_ROOT_PASSWORD=
MARIADB_DATABASE=atcrew
MARIADB_USERNAME=root
# 위 두 값이 일치해야 함(root로 접속하는 경우). 별도 앱 전용 계정을 만들 거면 두 값을 분리하고
# MariaDB 컨테이너 최초 기동 시 GRANT까지 직접 실행할 것.
MARIADB_PASSWORD=

# === Elasticsearch (EC2 #2, docker-compose.search.yml) ===
# EC2 #2의 프라이빗 IP:9200 — 같은 VPC 안에서만 접근 가능해야 한다(보안 그룹으로 제한).
ELASTICSEARCH_URIS=http://172.31.25.215:9200

# === Cloudflare R2 (media 모듈) ===
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=at-crew-storage

# === Cloudflare Worker (media 모듈 트리거/콜백) ===
# WORKER_TRIGGER_URL은 이미 배포된 워커 고정 URL(https://at-crew-media-worker.sehandev.workers.dev).
# WORKER_CALLBACK_SECRET은 Worker의 wrangler secret CALLBACK_SECRET과 동일해야 함.
WORKER_TRIGGER_URL=https://at-crew-media-worker.sehandev.workers.dev
WORKER_CALLBACK_SECRET=
# Worker의 wrangler secret SERVER_CALLBACK_URL도 이 서버가 뜬 뒤 실제 도메인으로 재등록해야 한다:
#   https://api.at-crew.com/internal/media/images/processed
ARTWORK_INTERNAL_SECRET=

# === search 모듈 내부 시크릿 ===
SEARCH_INTERNAL_SECRET=

# === Firebase ===
# 서비스 계정 JSON 파일을 이 deploy/ 디렉토리에 정확히 "firebase-credentials.json"이라는 이름으로
# 올려둘 것(git에 없음). docker-compose.app.yml이 그 파일을 컨테이너 안 /app/firebase-credentials.json
# 으로 마운트하고 FIREBASE_CREDENTIALS_PATH도 그 경로로 강제 덮어쓰므로, 아래 값은 실제로는 안 쓰인다
# (컨테이너 밖에서 값을 참고할 일이 있을까 봐 형식만 유지).
FIREBASE_CREDENTIALS_PATH=/app/firebase-credentials.json

# === CORS / JWT ===
CORS_ALLOWED_ORIGINS=https://at-crew.com
JWT_SECRET=

# === Stripe 결제/구독 (docs/design/billing-module-design.md) ===
# 값이 비어 있어도 앱은 기동되고 결제 API만 실패한다. 지금은 sandbox(test mode) 키를 쓴다.
# 주의: properties 형식이라 값 뒤에 같은 줄로 # 주석을 달면 주석까지 값에 섞인다.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# 대시보드 Webhooks에 등록한 destination의 Signing secret
# (엔드포인트: https://api.at-crew.com/internal/billing/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# Product catalog에서 만든 Price ID (prod_이 아니라 price_로 시작하는 값)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_TEAM_POSTING=
STRIPE_PRICE_BOOST=
STRIPE_PRICE_JOB_POSTING=

# Checkout 성공·취소 후 돌아갈 프론트 주소
FRONTEND_BASE_URL=https://at-crew.com
